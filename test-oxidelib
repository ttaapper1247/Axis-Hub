-- MUSIC PLAYER BUILDER (kept as its own function so its locals do not count
-- against CreateWindow's Luau local-register budget)
-- ════════════════════════════════════════════════════════════════════════════
-- Window controls: a small glass pill holding a minimize bar and a close
-- cross, drawn from frames so they stay sharp at any size. Hovering lights a
-- button (minimize in the accent colour, close in red with a soft glow) and a
-- press squeezes it. Returns the pill and both buttons; the caller wires the
-- clicks.
local CONTROL_RED = Color3.fromRGB(232, 72, 85)
local function windowControls(parent, zindex, position)
    local pill = make("Frame", {
        Name = "CornerControls", AnchorPoint = Vector2.new(1, 0), Position = position,
        Size = UDim2.fromOffset(52, 24), BackgroundColor3 = C.CardBg, BackgroundTransparency = 0.1,
        ZIndex = zindex, Parent = parent,
    })
    corner(pill, 8)
    stroke(pill, C.Border)
    -- lighter at the top, so it reads as a raised piece of glass
    make("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(214, 214, 214)),
        Parent = pill,
    })
    local function button(name, x, hot, icon)
        local color = hot or C.Accent
        local btn = make("TextButton", {
            Name = name, Text = "", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, x, 0.5, 0),
            Size = UDim2.fromOffset(22, 18), BackgroundColor3 = color, BackgroundTransparency = 1,
            ZIndex = zindex + 1, Parent = pill,
        })
        btn:SetAttribute("Theme_BackgroundColor3", nil)
        corner(btn, 6)
        local scale = make("UIScale", { Parent = btn })
        local glow = make("UIStroke", { Color = color, Thickness = 1.5, Transparency = 1, Parent = btn })
        glow:SetAttribute("Theme_Color", nil)
        local lines = {}
        for _, bar in ipairs(icon) do
            local l = make("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(bar[1], 2), Rotation = bar[2],
                BackgroundColor3 = C.TextGray, ZIndex = zindex + 2, Parent = btn,
            })
            corner(l, 1)
            table.insert(lines, l)
        end
        local over = false
        local function look()
            color = hot or C.Accent
            tween(btn, { BackgroundColor3 = color, BackgroundTransparency = over and (hot and 0 or 0.72) or 1 })
            tween(glow, { Color = color, Transparency = over and (hot and 0.45 or 0.6) or 1 })
            for _, l in ipairs(lines) do
                tween(l, { BackgroundColor3 = over and (hot and Color3.new(1, 1, 1) or C.Accent) or C.TextGray })
            end
        end
        btn.MouseEnter:Connect(function() over = true; look() end)
        btn.MouseLeave:Connect(function() over = false; look(); tween(scale, { Scale = 1 }) end)
        btn.MouseButton1Down:Connect(function() tween(scale, { Scale = 0.86 }) end)
        btn.MouseButton1Up:Connect(function() tween(scale, { Scale = 1 }) end)
        return btn
    end
    local minimizeBtn = button("Minimize", 3, nil, { { 9, 0 } })
    local closeBtn = button("Close", 27, CONTROL_RED, { { 10, 45 }, { 10, -45 } })
    return pill, minimizeBtn, closeBtn
end

