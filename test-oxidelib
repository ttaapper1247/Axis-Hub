    if opts.Visible==false then screenGui.Enabled=false end

    if loader then
        task.defer(function()
            while not loader.motionDone and screenGui.Parent and os.clock() < loader.deadline do RunService.Heartbeat:Wait() end
            if not screenGui.Parent then return end
            main.Visible=true; hotbar.Visible=true
            TweenService:Create(mainRevealScale,TweenInfo.new(0.46,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Scale=1}):Play()
            if loader.layer.Parent then loader.finish() end
            if not screenGui.Parent then return end; loadingComplete=true
        end)
    end

    if opts.Background ~= nil and opts.Background ~= "" then
        task.spawn(function() windowRef:SetBackground(opts.Background, opts.BackgroundSettings) end)
    end

    return windowRef
end

-- ════════════════════════════════════════════════════════════════════════════
-- WINDOW BACKGROUND
-- A picture or animated GIF drawn behind everything in the main window, under a
-- dim layer in the theme's window colour. Roblox cannot play GIFs, so a GIF is
-- decoded here and every frame is written out as a PNG, then the frames are
-- flipped on the GIF's own delays. The PNGs are cached by the file's content,
-- so only the first load of a GIF pays for the conversion.
-- ════════════════════════════════════════════════════════════════════════════
BG.CACHE_VERSION = 1

-- CRC-32 table for PNG chunks.
BG.crcTable = {}
for n = 0, 255 do
    local c = n
    for _ = 1, 8 do
        if bit32.band(c, 1) == 1 then c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1)) else c = bit32.rshift(c, 1) end
    end
    BG.crcTable[n + 1] = c
end

function BG.writeBE32(b, at, v)
    buffer.writeu8(b, at, bit32.band(bit32.rshift(v, 24), 255))
    buffer.writeu8(b, at + 1, bit32.band(bit32.rshift(v, 16), 255))
    buffer.writeu8(b, at + 2, bit32.band(bit32.rshift(v, 8), 255))
    buffer.writeu8(b, at + 3, bit32.band(v, 255))
end

-- CRC-32 of bytes first..last (inclusive). `pause` is an optional callback the
-- caller uses to yield on long runs.
function BG.crc32(b, first, last, pause)
    local T, band, bxor, rshift, readu8 = BG.crcTable, bit32.band, bit32.bxor, bit32.rshift, buffer.readu8
    local c = 0xFFFFFFFF
    local i = first
    while i <= last do
        local stop = math.min(i + 65535, last)
        for j = i, stop do
            c = bxor(T[band(bxor(c, readu8(b, j)), 255) + 1], rshift(c, 8))
        end
        i = stop + 1
        if pause then pause() end
    end
    return bxor(c, 0xFFFFFFFF)
end

-- RGBA pixels (w*h*4 bytes, rows top to bottom) -> PNG file contents. The image
-- data is stored uncompressed (deflate "stored" blocks): files come out larger,
-- but there is no compressor to run in Luau and every PNG reader accepts it.
function BG.encodePng(w, h, px, pause)
    local readu8 = buffer.readu8
    local rowLen = w * 4 + 1
    local rawLen = rowLen * h
    local raw = buffer.create(rawLen) -- zero-filled, so every row's filter byte is already 0
    for y = 0, h - 1 do
        buffer.copy(raw, y * rowLen + 1, px, y * w * 4, w * 4)
    end
    local a, b = 1, 0
    local i = 0
    while i < rawLen do
        local stop = math.min(i + 65536, rawLen) - 1
        for j = i, stop do
            a += readu8(raw, j)
            b += a
        end
        a %= 65521; b %= 65521
        i = stop + 1
        if pause then pause() end
    end

    local blocks = math.max(1, math.ceil(rawLen / 65535))
    local zLen = 2 + rawLen + blocks * 5 + 4
    local out = buffer.create(8 + 25 + 12 + zLen + 12)
    buffer.writestring(out, 0, "\137PNG\r\n\26\n")
    BG.writeBE32(out, 8, 13)
    buffer.writestring(out, 12, "IHDR")
    BG.writeBE32(out, 16, w)
    BG.writeBE32(out, 20, h)
    buffer.writeu8(out, 24, 8) -- 8 bits per channel
    buffer.writeu8(out, 25, 6) -- RGBA
    BG.writeBE32(out, 29, BG.crc32(out, 12, 28))
    BG.writeBE32(out, 33, zLen)
    buffer.writestring(out, 37, "IDAT")
    local p = 41
    buffer.writeu8(out, p, 0x78); buffer.writeu8(out, p + 1, 0x01)
    p += 2
    local off = 0
    for blk = 1, blocks do
        local n = math.min(65535, rawLen - off)
        buffer.writeu8(out, p, blk == blocks and 1 or 0)
        buffer.writeu16(out, p + 1, n)
        buffer.writeu16(out, p + 3, bit32.bxor(n, 0xFFFF))
        p += 5
        buffer.copy(out, p, raw, off, n)
        p += n; off += n
    end
    BG.writeBE32(out, p, bit32.bor(bit32.lshift(b, 16), a))
    p += 4
    BG.writeBE32(out, p, BG.crc32(out, 37, p - 1, pause))
    p += 4
    BG.writeBE32(out, p, 0)
    buffer.writestring(out, p + 4, "IEND")
    BG.writeBE32(out, p + 8, 0xAE426082)
    return buffer.tostring(out)
end

function BG.skipSubBlocks(src, pos, len)
    while pos < len do
        local n = buffer.readu8(src, pos); pos += 1
        if n == 0 then break end
        pos += n
    end
    return pos
end

function BG.countGifFrames(src, pos)
    local len, n = buffer.len(src), 0
    while pos < len do
        local block = buffer.readu8(src, pos); pos += 1
        if block == 0x21 then
            pos = BG.skipSubBlocks(src, pos + 1, len)
        elseif block == 0x2C then
            if pos + 9 > len then break end
            local pk = buffer.readu8(src, pos + 8)
            pos += 9
            if bit32.band(pk, 0x80) ~= 0 then pos += bit32.lshift(1, bit32.band(pk, 7) + 1) * 3 end
            pos = BG.skipSubBlocks(src, pos + 1, len)
            n += 1
        else
            break
        end
    end
    return n
end

-- Row order of an interlaced GIF image: rows[decoded row + 1] = real row.
function BG.interlaceRows(h)
    local rows, n = table.create(h), 0
    for _, pass in ipairs({ { 0, 8 }, { 4, 8 }, { 2, 4 }, { 1, 2 } }) do
        for y = pass[1], h - 1, pass[2] do
            n += 1
            rows[n] = y
        end
    end
    return rows
end

-- GIF LZW: decodes up to outLen colour indices into `out`, returns how many.
function BG.lzw(data, dataLen, minCode, out, outLen, prefix, suffix, stack, pause)
    local readu8, writeu8, readu16, writeu16 = buffer.readu8, buffer.writeu8, buffer.readu16, buffer.writeu16
    local band, lshift, rshift = bit32.band, bit32.lshift, bit32.rshift
    local clear = lshift(1, minCode)
    local eoi = clear + 1
    local codeSize = minCode + 1
    local codeMask = lshift(1, codeSize) - 1
    local nextCode = eoi + 1
    local prev, first = -1, 0
    local bits, nbits, dp, op = 0, 0, 0, 0
    local nextPause = 16384
    while op < outLen do
        while nbits < codeSize and dp < dataLen do
            bits += lshift(readu8(data, dp), nbits)
            dp += 1; nbits += 8
        end
        if nbits < codeSize then break end
        local code = band(bits, codeMask)
        bits = rshift(bits, codeSize); nbits -= codeSize
        if code == clear then
            codeSize = minCode + 1
            codeMask = lshift(1, codeSize) - 1
            nextCode = eoi + 1
            prev = -1
        elseif code == eoi then
            break
        elseif prev == -1 then
            if code >= clear then break end
            writeu8(out, op, code); op += 1
            prev, first = code, code
        else
            local inCode, sp = code, 0
            if code >= nextCode then
                if code > nextCode then break end
                writeu8(stack, 0, first); sp = 1
                code = prev
            end
            while code > eoi and sp < 4096 do
                writeu8(stack, sp, readu8(suffix, code)); sp += 1
                code = readu16(prefix, code * 2)
            end
            first = band(code, 255)
            writeu8(stack, sp, first); sp += 1
            if nextCode < 4096 then
                writeu16(prefix, nextCode * 2, prev)
                writeu8(suffix, nextCode, first)
                nextCode += 1
                if nextCode > codeMask and codeSize < 12 then
                    codeSize += 1
                    codeMask = lshift(1, codeSize) - 1
                end
            end
            prev = inCode
            while sp > 0 and op < outLen do
                sp -= 1
                writeu8(out, op, readu8(stack, sp)); op += 1
            end
        end
        if pause and op >= nextPause then
            nextPause = op + 16384
            pause()
        end
    end
    return op
end

function BG.scaleInto(dst, dw, dh, src, xmap, ymap)
    local readu32, writeu32 = buffer.readu32, buffer.writeu32
    local o = 0
    for y = 1, dh do
        local row = ymap[y]
        for x = 1, dw do
            writeu32(dst, o, readu32(src, row + xmap[x]))
            o += 4
        end
    end
end

-- Decodes a GIF (the file contents as a string) frame by frame.
--   opts.OnFrame(index, width, height, rgbaBuffer)  called for every kept frame;
--       return false to stop. The buffer is reused, so copy it or encode it now.
--   opts.TargetWidth / TargetHeight  shrink (never grow) to the smallest size
--       that still covers this box, since nothing larger is ever shown.
--   opts.MaxFrames  long GIFs are thinned evenly to at most this many frames.
--   opts.Pause  optional callback called regularly so the caller can yield.
-- Returns { width, height, outWidth, outHeight, delays (ms per kept frame),
-- sourceFrames } or nil plus a reason.
function BG.decodeGif(data, opts)
    opts = opts or {}
    local readu8, readu16, writeu32 = buffer.readu8, buffer.readu16, buffer.writeu32
    local band, lshift, rshift = bit32.band, bit32.lshift, bit32.rshift
    local pause = opts.Pause
    local src = buffer.fromstring(data)
    local len = buffer.len(src)
    if len < 13 or buffer.readstring(src, 0, 4) ~= "GIF8" then return nil, "that file is not a GIF" end
    local W, H = readu16(src, 6), readu16(src, 8)
    if W < 1 or H < 1 then return nil, "the GIF has no size" end
    local flags = readu8(src, 10)
    local pos = 13
    local gctPos, gctN = nil, 0
    if band(flags, 0x80) ~= 0 then
        gctN = lshift(1, band(flags, 7) + 1)
        gctPos = pos
        pos += gctN * 3
    end
    local total = BG.countGifFrames(src, pos)
    if total < 1 then return nil, "the GIF has no frames" end
    local step = math.max(1, math.ceil(total / math.max(1, tonumber(opts.MaxFrames) or 120)))

    local outW, outH = W, H
    local tw, th = tonumber(opts.TargetWidth), tonumber(opts.TargetHeight)
    if tw and th and tw > 0 and th > 0 then
        local s = math.max(tw / W, th / H)
        if s < 1 then outW, outH = math.max(1, math.floor(W * s + 0.5)), math.max(1, math.floor(H * s + 0.5)) end
    end
    local cap = tonumber(opts.MaxSide) or 1024 -- Roblox does not show textures larger than this
    if outW > cap or outH > cap then
        local s = math.min(cap / outW, cap / outH)
        outW, outH = math.max(1, math.floor(outW * s)), math.max(1, math.floor(outH * s))
    end
    local scaled = outW ~= W or outH ~= H
    local xmap, ymap
    if scaled then
        xmap, ymap = table.create(outW), table.create(outH)
        for x = 1, outW do xmap[x] = math.min(W - 1, math.floor((x - 0.5) * W / outW)) * 4 end
        for y = 1, outH do ymap[y] = math.min(H - 1, math.floor((y - 0.5) * H / outH)) * W * 4 end
    end

    local size = W * H * 4
    local canvas = buffer.create(size) -- starts fully transparent
    local saved = nil
    local out = scaled and buffer.create(outW * outH * 4) or canvas
    local idx = buffer.create(W * H)
    local prefix, suffix, stack = buffer.create(8192), buffer.create(4096), buffer.create(4100)
    local palette = table.create(256, 0)
    local disposal, delay, transparent = 0, 10, -1
    local frameNo, kept, delays = 0, 0, {}

    while pos < len do
        local block = readu8(src, pos); pos += 1
        if block == 0x3B then
            break
        elseif block == 0x21 then
            if pos >= len then break end
            local label = readu8(src, pos); pos += 1
            if label == 0xF9 and pos + 4 < len and readu8(src, pos) >= 4 then
                local pk = readu8(src, pos + 1)
                disposal = band(rshift(pk, 2), 7)
                delay = readu16(src, pos + 2)
                transparent = band(pk, 1) == 1 and readu8(src, pos + 4) or -1
            end
            pos = BG.skipSubBlocks(src, pos, len)
        elseif block == 0x2C then
            if pos + 9 > len then break end
            local fx, fy = readu16(src, pos), readu16(src, pos + 2)
            local fw, fh = readu16(src, pos + 4), readu16(src, pos + 6)
            local pk = readu8(src, pos + 8)
            pos += 9
            local palPos, palN = gctPos, gctN
            if band(pk, 0x80) ~= 0 then
                palN = lshift(1, band(pk, 7) + 1)
                palPos = pos
                pos += palN * 3
            end
            if pos >= len then break end
            local minCode = readu8(src, pos); pos += 1
            -- the image data comes in sub-blocks of up to 255 bytes; join them
            local runLen, p = 0, pos
            while p < len do
                local n = readu8(src, p); p += 1
                if n == 0 then break end
                runLen += n; p += n
            end
            local run = buffer.create(math.max(runLen, 1))
            local got = 0
            while pos < len do
                local n = readu8(src, pos); pos += 1
                if n == 0 then break end
                n = math.min(n, len - pos)
                if n <= 0 then break end
                buffer.copy(run, got, src, pos, n)
                got += n; pos += n
            end

            if disposal == 3 then
                saved = saved or buffer.create(size)
                buffer.copy(saved, 0, canvas, 0, size)
            end
            local pixels = fw * fh
            if pixels > 0 and minCode >= 1 and minCode <= 8 and palPos then
                if buffer.len(idx) < pixels then idx = buffer.create(pixels) end
                local count = BG.lzw(run, got, minCode, idx, pixels, prefix, suffix, stack, pause)
                for i = 0, palN - 1 do
                    local pp = palPos + i * 3
                    if pp + 2 < len then
                        palette[i + 1] = readu8(src, pp) + readu8(src, pp + 1) * 256 + readu8(src, pp + 2) * 65536 + 4278190080
                    else
                        palette[i + 1] = 4278190080
                    end
                end
                local rows = band(pk, 0x40) ~= 0 and BG.interlaceRows(fh) or nil
                local visible = math.min(fw, W - fx)
                for r = 0, fh - 1 do
                    local rowStart = r * fw
                    if rowStart >= count then break end
                    local cy = fy + (rows and rows[r + 1] or r)
                    if cy < H then
                        local base = (cy * W + fx) * 4
                        for x = 0, math.min(visible, count - rowStart) - 1 do
                            local ci = readu8(idx, rowStart + x)
                            if ci ~= transparent and ci < palN then
                                writeu32(canvas, base + x * 4, palette[ci + 1])
                            end
                        end
                    end
                end
            end

            frameNo += 1
            if (frameNo - 1) % step == 0 then
                kept += 1
                delays[kept] = 0
                if scaled then BG.scaleInto(out, outW, outH, canvas, xmap, ymap) end
                if opts.OnFrame and opts.OnFrame(kept, outW, outH, out) == false then
                    return nil, "a frame could not be saved"
                end
                if pause then pause() end
            end
            -- browsers play delays of 0 or 1 hundredths as 10, so match them
            delays[kept] += (delay <= 1 and 10 or delay) * 10

            if disposal == 2 then
                local x0, x1 = math.max(fx, 0), math.min(fx + fw, W)
                if x1 > x0 then
                    for y = fy, math.min(fy + fh, H) - 1 do
                        buffer.fill(canvas, (y * W + x0) * 4, 0, (x1 - x0) * 4)
                    end
                end
            elseif disposal == 3 and saved then
                buffer.copy(canvas, 0, saved, 0, size)
            end
            disposal, delay, transparent = 0, 10, -1
        else
            break
        end
    end
    if kept == 0 then return nil, "the GIF has no frames" end
    return { width = W, height = H, outWidth = outW, outHeight = outH, delays = delays, sourceFrames = frameNo }
end

-- The picture's main colour, for tinting the tab bar and anything else that
-- asks: the most common clearly coloured hue, brightened so it works as an
-- accent. Nil for a black, white or grey picture. `px` is RGBA, rows top to
-- bottom, as decodeGif hands it out.
function BG.pickAccent(px, w, h)
    local readu8 = buffer.readu8
    local n = w * h
    local step = math.max(1, math.floor(n / 8000))
    local weight, sumR, sumG, sumB = table.create(24, 0), table.create(24, 0), table.create(24, 0), table.create(24, 0)
    local samples, colourful = 0, 0
    for i = 0, n - 1, step do
        local o = i * 4
        if readu8(px, o + 3) > 127 then
            samples += 1
            local r, g, b = readu8(px, o), readu8(px, o + 1), readu8(px, o + 2)
            local hue, sat, val = Color3.fromRGB(r, g, b):ToHSV()
            if sat > 0.25 and val > 0.2 then
                local bin = math.floor(hue * 24) % 24 + 1
                local wt = sat * val
                weight[bin] += wt
                sumR[bin] += r * wt; sumG[bin] += g * wt; sumB[bin] += b * wt
                colourful += wt
            end
        end
    end
    if samples == 0 or colourful < samples * 0.02 then return nil end
    -- the busiest hue, counting half of each neighbour so a colour that
    -- sits on a bin edge is not split in two
    local best, bestScore = 1, -1
    for i = 1, 24 do
        local score = weight[i] + 0.5 * (weight[(i - 2) % 24 + 1] + weight[i % 24 + 1])
        if score > bestScore then best, bestScore = i, score end
    end
    local wt, r, g, b = 0, 0, 0, 0
    for _, pick in ipairs({ { best, 1 }, { (best - 2) % 24 + 1, 0.5 }, { best % 24 + 1, 0.5 } }) do
        local i, k = pick[1], pick[2]
        wt += weight[i] * k; r += sumR[i] * k; g += sumG[i] * k; b += sumB[i] * k
    end
    if wt <= 0 then return nil end
    local hue, sat, val = Color3.fromRGB(r / wt, g / wt, b / wt):ToHSV()
    local c = Color3.fromHSV(hue, math.clamp(sat, 0.35, 0.85), math.clamp(val, 0.75, 1))
    return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end

-- Width and height from a PNG or JPG file's header, or nil.
function BG.imageSize(data)
    if type(data) ~= "string" then return nil end
    local byte = string.byte
    if string.sub(data, 1, 8) == "\137PNG\r\n\26\n" and #data >= 24 then
        local function be32(i)
            local a, b, c, d = byte(data, i, i + 3)
            return ((a * 256 + b) * 256 + c) * 256 + d
        end
        return be32(17), be32(21)
    end
    if string.sub(data, 1, 2) == "\255\216" then
        local p, n = 3, #data
        while p + 8 <= n do
            local m = byte(data, p + 1)
            if byte(data, p) ~= 255 or m == 255 then
                p += 1
            elseif m == 0xD8 or m == 0x01 or (m >= 0xD0 and m <= 0xD7) then
                p += 2
            elseif m == 0xD9 or m == 0xDA then
                return nil
            elseif m >= 0xC0 and m <= 0xCF and m ~= 0xC4 and m ~= 0xC8 and m ~= 0xCC then
                return byte(data, p + 7) * 256 + byte(data, p + 8), byte(data, p + 5) * 256 + byte(data, p + 6)
            else
                p += 2 + byte(data, p + 2) * 256 + byte(data, p + 3)
            end
        end
    end
    return nil
end

-- ── Loading a background source ───────────────────────────────────────────
function BG.fileExists(path)
    if type(isfile) ~= "function" then return false end
    local ok, yes = pcall(isfile, path)
    return ok and yes == true
end
function BG.folderExists(path)
    if type(isfolder) ~= "function" then return false end
    local ok, yes = pcall(isfolder, path)
    return ok and yes == true
end
function BG.makeFolders(path)
    if type(makefolder) ~= "function" then return end
    local built = ""
    for _, part in ipairs(string.split(path, "/")) do
        if part ~= "" then
            built = (built == "") and part or (built .. "/" .. part)
            if not BG.folderExists(built) then pcall(makefolder, built) end
        end
    end
end
function BG.customAsset(path)
    local load = getcustomasset or getsynasset
    if type(load) ~= "function" then
        return nil, "your executor has no getcustomasset, so only rbxassetid works"
    end
    -- on some executors a file is only usable a moment after writefile
    -- returns, so a GIF frame saved a moment ago fails on the first go
    local stop = os.clock() + 5
    while true do
        local ok, id = pcall(load, path)
        if ok and type(id) == "string" and id ~= "" then return id end
        if os.clock() > stop then return nil, "could not load " .. tostring(path) end
        task.wait(0.2)
    end
end

-- FNV-1a over (a sample of) the bytes, plus the length. Names the cache folder.
function BG.hash(data)
    local h, n = 2166136261, #data
    local stride = math.max(1, math.floor(n / 262144))
    local byte, bxor, lshift = string.byte, bit32.bxor, bit32.lshift
    for i = 1, n, stride do
        h = bxor(h, byte(data, i))
        h = (lshift(h, 24) + h * 403) % 4294967296 -- * 16777619, kept exact in 32 bits
    end
    return string.format("%08x%x", h, n)
end

function BG.sniff(data)
    if string.sub(data, 1, 4) == "GIF8" then return "gif" end
    if string.sub(data, 1, 8) == "\137PNG\r\n\26\n" then return "png" end
    if string.sub(data, 1, 3) == "\255\216\255" then return "jpg" end
    return nil
end

function BG.evenDelays(n, settings)
    local ms = 1000 / math.clamp(tonumber(settings.FPS) or 15, 1, 60)
    local out = table.create(n)
    for i = 1, n do out[i] = ms end
    return out
end

-- One still image: an asset id, or a file path for getcustomasset.
function BG.still(value, folder)
    if type(value) == "number" then return "rbxassetid://" .. math.floor(value) end
    local text = tostring(value)
    if string.match(text, "^rbxasset") or string.match(text, "^rbxthumb://") then return text end
    if string.match(text, "^%d+$") then return "rbxassetid://" .. text end
    local path = string.gsub(text, "\\", "/")
    if not BG.fileExists(path) and BG.fileExists(folder .. "/" .. path) then path = folder .. "/" .. path end
    return BG.customAsset(path)
end

-- A folder of numbered PNG/JPG frames (e.g. split from a GIF with ezgif).
function BG.folderFrames(path, settings)
    if type(listfiles) ~= "function" then return nil, "your executor has no listfiles" end
    local ok, files = pcall(listfiles, path)
    if not ok or type(files) ~= "table" then return nil, "could not read the folder " .. path end
    local list = {}
    for _, file in ipairs(files) do
        file = string.gsub(tostring(file), "\\", "/")
        local lower = string.lower(file)
        if string.match(lower, "%.png$") or string.match(lower, "%.jpe?g$") then
            local name = string.match(file, "([^/]+)$") or file
            table.insert(list, { path = file, name = name, n = tonumber(string.match(name, "(%d+)")) or math.huge })
        end
    end
    if #list == 0 then return nil, "no .png or .jpg frames in " .. path end
    table.sort(list, function(a, b)
        if a.n ~= b.n then return a.n < b.n end
        return a.name < b.name
    end)
    local ids = {}
    for i, entry in ipairs(list) do
        local id, err = BG.customAsset(entry.path)
        if not id then return nil, err end
        ids[i] = id
    end
    return { kind = #ids > 1 and "frames" or "image", ids = ids, delays = BG.evenDelays(#ids, settings) }
end

function BG.gifFrames(data, folder, settings, target, status, alive)
    if type(buffer) ~= "table" then return nil, "your executor is too old to read GIFs" end
    if type(writefile) ~= "function" or type(readfile) ~= "function" then
        return nil, "your executor can't save files, so GIFs won't work"
    end
    local maxFrames = math.clamp(math.floor(tonumber(settings.MaxFrames) or 120), 1, 400)
    local key = string.format("%s_%dx%d_%d_v%d", BG.hash(data), target.X, target.Y, maxFrames, BG.CACHE_VERSION)
    local dir = folder .. "/cache/" .. key
    local metaPath = dir .. "/frames.json"
    -- Frame files carry the key in their name. Some executors copy every
    -- getcustomasset file into one folder by name alone, so plain 1.png,
    -- 2.png were shared by every GIF and Roblox kept showing the frames it
    -- had loaded for the last one in between the new ones.
    local function frameFile(i) return dir .. "/" .. key .. "_" .. i .. ".png" end
    local function oldFrameFile(i) return dir .. "/" .. i .. ".png" end
    local meta
    if BG.fileExists(metaPath) then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(metaPath)) end)
        if ok and type(decoded) == "table" and type(decoded.delays) == "table" and #decoded.delays > 0 then
            local n = #decoded.delays
            if BG.fileExists(frameFile(n)) then
                meta = decoded
            elseif BG.fileExists(oldFrameFile(n)) then
                -- saved before the frames were named per GIF: copy them over
                meta = decoded
                for i = 1, n do
                    if not BG.fileExists(frameFile(i)) then
                        local okRead, body = pcall(readfile, oldFrameFile(i))
                        if not (okRead and type(body) == "string" and pcall(writeLarge, frameFile(i), body)) then
                            meta = nil -- convert it again instead
                            break
                        end
                    end
                    if type(delfile) == "function" then pcall(delfile, oldFrameFile(i)) end
                    if i % 8 == 0 then task.wait() end
                end
            end
        end
    end
    if not meta then
        if settings.CacheOnly then return nil, "not converted yet" end
        status("converting")
        BG.makeFolders(dir)
        local last = os.clock()
        local function pause()
            if os.clock() - last > 0.012 then
                task.wait(); last = os.clock()
                -- a newer background was picked, so stop converting this one
                if alive and not alive() then error("replaced", 0) end
            end
        end
        local accent
        local info, err = BG.decodeGif(data, {
            TargetWidth = target.X, TargetHeight = target.Y, MaxFrames = maxFrames, Pause = pause,
            OnFrame = function(i, w, h, px)
                if i == 1 then
                    local ok, got = pcall(BG.pickAccent, px, w, h)
                    accent = ok and got or nil
                end
                return (pcall(writeLarge, frameFile(i), BG.encodePng(w, h, px, pause)))
            end,
        })
        if not info then return nil, err end
        meta = {
            delays = info.delays, width = info.outWidth, height = info.outHeight,
            sourceWidth = info.width, sourceHeight = info.height, sourceFrames = info.sourceFrames,
            accent = accent or false,
        }
        pcall(writeLarge, metaPath, HttpService:JSONEncode(meta))
    end
    if meta.accent == nil and not settings.CacheOnly then
        -- converted before colours were picked: read only the first frame
        local got
        local last = os.clock()
        pcall(BG.decodeGif, data, {
            TargetWidth = 128, TargetHeight = 128, MaxFrames = 1,
            Pause = function()
                if os.clock() - last > 0.012 then task.wait(); last = os.clock() end
            end,
            OnFrame = function(_, w, h, px)
                local ok, c = pcall(BG.pickAccent, px, w, h)
                got = ok and c or nil
                return false
            end,
        })
        meta.accent = got or false
        pcall(writeLarge, metaPath, HttpService:JSONEncode(meta))
    end
    local ids = {}
    for i = 1, #meta.delays do
        local id, err = BG.customAsset(frameFile(i))
        if not id then return nil, err end
        ids[i] = id
    end
    return {
        kind = #ids > 1 and "gif" or "image", ids = ids, delays = meta.delays,
        width = meta.width, height = meta.height,
        sourceWidth = meta.sourceWidth, sourceHeight = meta.sourceHeight,
        accent = meta.accent or nil,
    }
end

-- Discord's link-preview proxy wraps the real link:
-- /external/<signature>/[%3Fquery/]https/host/path
function BG.unwrapDiscordProxy(host, path)
    if not string.match(host, "^images%-ext%-%d+%.discordapp%.net$") then return nil end
    local rest = string.match(path, "^/external/[^/]+/(.+)$")
    if not rest then return nil end
    local query = ""
    local q, after = string.match(rest, "^(%%3[Ff][^/]*)/(.+)$")
    if q then
        query = string.gsub(q, "%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
        rest = after
    end
    local scheme, tail = string.match(rest, "^(https?)/(.+)$")
    if not scheme then return nil end
    return scheme .. "://" .. tail .. query
end

-- GIF sites hand a clip out as a video or a WEBP too; the GIF of the same clip
-- sits at a matching address
function BG.gifSibling(host, path)
    local stem, ext = string.match(path, "^(.+)%.(%w+)$")
    if not stem then return nil end
    ext = string.lower(ext)
    if ext ~= "mp4" and ext ~= "webm" and ext ~= "webp" and ext ~= "gifv" then return nil end
    if host == "static.klipy.com" or host == "i.imgur.com" or host == "i.giphy.com"
        or string.match(host, "^media%d*%.giphy%.com$") then
        return "https://" .. host .. stem .. ".gif"
    end
    if string.match(host, "^media%d*%.tenor%.com$") or host == "c.tenor.com" then
        -- /<id><5 letter format>/<name>; AAAAC is the full size GIF
        local id, name = string.match(stem, "^/([%w_%-]+)/([^/]+)$")
        if id and #id > 5 then
            return "https://" .. host .. "/" .. string.sub(id, 1, -6) .. "AAAAC/" .. name .. ".gif"
        end
    end
    return nil
end

-- Discord's media proxy re-encodes uploads and answers &format=webp with a WEBP,
-- so attachment links are pointed at the CDN, which serves the file as uploaded.
-- The attachment path (not the signature, which runs out after about a day)
-- names the saved copy, so a link keeps working once it has loaded.
function BG.linkInfo(url)
    local host, path, query = string.match(url, "^https?://([^/%?#]+)([^%?#]*)%??([^#]*)")
    if not host then return url, url, false end
    host = string.lower(host)
    local inner = BG.unwrapDiscordProxy(host, path)
    if inner then return BG.linkInfo(inner) end
    local gif = BG.gifSibling(host, path)
    if gif then return gif, gif, false end
    if (host == "media.discordapp.net" or host == "cdn.discordapp.com") and string.match(path, "^/attachments/") then
        local keep = {}
        for pair in string.gmatch(query, "[^&]+") do
            local name = string.match(pair, "^([^=]*)")
            if name == "ex" or name == "is" or name == "hm" then table.insert(keep, pair) end
        end
        local fetch = "https://cdn.discordapp.com" .. path .. (#keep > 0 and ("?" .. table.concat(keep, "&")) or "")
        return fetch, "discord:" .. path, true
    end
    return url, url, false
end

-- The executor's request function goes first: it reports the status code and
-- keeps binary bodies intact on more executors than HttpGet does.
function BG.download(url, discord, folder)
    local replies = {}
    local function usable(body)
        if type(body) ~= "string" or not BG.sniff(body) then return false end
        -- a client that decodes the body as text turns bytes >= 128 into U+FFFD
        local _, mangled = string.gsub(string.sub(body, 1, 65536), "\239\191\189", "")
        return mangled < 8
    end
    local req = (syn and syn.request) or http_request or request or (http and http.request)
    if type(req) == "function" then
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if ok and type(res) == "table" then
            local body = res.Body or res.body
            if usable(body) then return body end
            table.insert(replies, { code = tonumber(res.StatusCode or res.Status or res.status_code), body = body })
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and usable(body) then return body end
    table.insert(replies, { body = ok and body or nil, err = not ok and tostring(body) or nil })

    local code, sample, damaged, err = nil, "", false, nil
    for _, reply in ipairs(replies) do
        code = code or reply.code
        err = err or reply.err
        if type(reply.body) == "string" and reply.body ~= "" then
            if BG.sniff(reply.body) then damaged = true end
            if sample == "" then sample = string.sub(reply.body, 1, 512) end
        end
    end
    local expired = string.find(sample, "no longer available", 1, true) or code == 403 or code == 404
    if discord and (expired or string.find(tostring(err), "40[34]")) then
        return nil, "the Discord link expired - copy it from Discord again"
    end
    if damaged then
        return nil, "your executor broke the download - save the GIF in " .. folder .. " and type its name"
    end
    if expired then return nil, "the link is dead (" .. (code or 404) .. ")" end
    if string.sub(sample, 5, 8) == "ftyp" then
        return nil, "that link is a video (MP4) - copy a GIF link instead"
    end
    if string.sub(sample, 1, 4) == "\26\69\223\163" then
        return nil, "that link is a video (WEBM) - copy a GIF link instead"
    end
    if string.sub(sample, 1, 4) == "RIFF" and string.sub(sample, 9, 12) == "WEBP" then
        if string.match(string.lower(string.match(url, "^[^%?#]*")), "%.gif$") then
            return nil, "that file is a WEBP named .gif - turn it into a real GIF (ezgif.com/webp-to-gif)"
        end
        return nil, "that link is a WEBP - turn it into a GIF first (ezgif.com/webp-to-gif)"
    end
    if string.match(sample, "^%s*<") then
        return nil, "that link is a web page - copy the link of the GIF itself"
    end
    if code then return nil, "the link gave error " .. code end
    return nil, "download failed" .. (err and (": " .. err) or "")
end

-- Turns whatever the caller passed into a list of image ids (+ frame delays).
function BG.resolve(source, settings, target, status, alive)
    local folder = string.gsub(tostring(Library.BackgroundFolder or "Oxidelib/backgrounds"), "/+$", "")
    if type(source) == "number" then return { kind = "image", ids = { "rbxassetid://" .. math.floor(source) } } end
    if type(source) == "table" then
        local ids = {}
        for _, value in ipairs(source) do
            local id, err = BG.still(value, folder)
            if not id then return nil, err end
            table.insert(ids, id)
        end
        if #ids == 0 then return nil, "the frame list is empty" end
        return { kind = #ids > 1 and "frames" or "image", ids = ids, delays = BG.evenDelays(#ids, settings) }
    end

    local text = string.match(tostring(source), "^%s*(.-)%s*$")
    if string.match(text, "^rbxasset") or string.match(text, "^rbxthumb://") then return { kind = "image", ids = { text } } end
    if string.match(text, "^%d+$") then return { kind = "image", ids = { "rbxassetid://" .. text } } end

    local data, savedPath
    if string.match(text, "^https?://") then
        -- links are saved the first time, so they load offline and outlive
        -- expiring links; settings.Refresh downloads the link again
        local fetchUrl, key, discord = BG.linkInfo(text)
        local stem = folder .. "/cache/url_" .. BG.hash(key)
        local function readSaved()
            for _, ext in ipairs({ "gif", "png", "jpg" }) do
                local path = stem .. "." .. ext
                if BG.fileExists(path) then
                    local ok, body = pcall(readfile, path)
                    if ok and type(body) == "string" and BG.sniff(body) == ext then return body, path end
                end
            end
            return nil
        end
        if not settings.Refresh then data, savedPath = readSaved() end
        if not data then
            if settings.CacheOnly then return nil, "not saved yet" end
            status("downloading")
            local body, err = BG.download(fetchUrl, discord, folder)
            if body then
                data = body
                if type(writefile) == "function" then
                    BG.makeFolders(folder .. "/cache")
                    local kind = BG.sniff(body)
                    for _, ext in ipairs({ "gif", "png", "jpg" }) do
                        if ext ~= kind and BG.fileExists(stem .. "." .. ext) and type(delfile) == "function" then
                            pcall(delfile, stem .. "." .. ext)
                        end
                    end
                    if pcall(writeLarge, stem .. "." .. kind, body) then savedPath = stem .. "." .. kind end
                end
            else
                -- the link stopped working, but the copy from last time is still good
                data, savedPath = readSaved()
                if not data then return nil, err end
            end
        end
    else
        local path = string.gsub(text, "\\", "/")
        if not BG.fileExists(path) and not BG.folderExists(path) then
            local inFolder = folder .. "/" .. path
            if BG.fileExists(inFolder) or BG.folderExists(inFolder) then path = inFolder end
        end
        if BG.folderExists(path) then return BG.folderFrames(path, settings) end
        if not BG.fileExists(path) then
            return nil, "can't find " .. text .. " in your workspace or in " .. folder
        end
        local ext = string.lower(string.match(path, "%.(%w+)$") or "")
        if ext == "png" or ext == "jpg" or ext == "jpeg" then
            local id, err = BG.customAsset(path)
            if not id then return nil, err end
            local okRead, body = pcall(readfile, path)
            local w, h = BG.imageSize(okRead and body or nil)
            return { kind = "image", ids = { id }, width = w, height = h }
        end
        local ok, body = pcall(readfile, path)
        if not ok or type(body) ~= "string" or body == "" then return nil, "could not read " .. path end
        data = body
    end

    local kind = BG.sniff(data)
    if kind == "gif" then return BG.gifFrames(data, folder, settings, target, status, alive) end
    if kind == "png" or kind == "jpg" then
        -- a downloaded picture has to be on disk before getcustomasset can use it
        local path = savedPath
        if not path then
            if type(writefile) ~= "function" then return nil, "your executor can't save files" end
            BG.makeFolders(folder .. "/cache")
            path = folder .. "/cache/" .. BG.hash(data) .. "." .. kind
            if not BG.fileExists(path) and not pcall(writeLarge, path, data) then
                return nil, "couldn't save the picture"
            end
        end
        local id, err = BG.customAsset(path)
        if not id then return nil, err end
        local w, h = BG.imageSize(data)
        return { kind = "image", ids = { id }, width = w, height = h }
    end
    if string.sub(data, 1, 4) == "RIFF" and string.sub(data, 9, 12) == "WEBP" then
        return nil, "that is a WEBP - turn it into a GIF first (ezgif.com/webp-to-gif)"
    end
    if string.match(data, "^%s*<") then
        return nil, "that link is a web page - copy the link of the GIF itself"
    end
    return nil, "only GIF, PNG and JPG work"
end

-- ── Drawing it ────────────────────────────────────────────────────────────
function BG.state(win)
    local bg = win._bg
    if not bg then
        bg = {
            token = 0, dim = 0.45, cards = 0.25, speed = 1, scale = "Crop", status = "off",
            orig = setmetatable({}, { __mode = "k" }),
            hosts = {}, -- places that show a copy of the background (the tab bar and any added)
        }
        win._bg = bg
    end
    return bg
end

function BG.untrack(win, conn)
    local list = win._connections
    local i = list and table.find(list, conn)
    if i then table.remove(list, i) end
end

-- Sets a transparency while keeping the drag fade's saved copy in step, so the
-- fade does not put back an old value when the drag ends.
function BG.setProp(win, inst, prop, value)
    local rec = win._fadeOrig and win._fadeOrig[inst]
    if rec and rec[prop] ~= nil then
        rec[prop] = value
        if win._isInnerHidden and win._isInnerHidden() then return end
    end
    inst[prop] = value
end

function BG.designValue(win, inst, prop)
    if win._isInnerHidden and win._isInnerHidden() then
        local rec = win._fadeOrig and win._fadeOrig[inst]
        if rec and rec[prop] ~= nil then return rec[prop] end
    end
    return inst[prop]
end

-- What the glass pass wants for an instance: cards go see-through by the card
-- setting, and anything painted in the window colour (idle sub-tab pills) was
-- only there to blend with the window, so it goes fully clear.
function BG.glassWant(win, inst)
    local bg = win._bg
    if inst == win._brand then return bg.cards end
    local key = inst:GetAttribute("Theme_BackgroundColor3")
    if key == "CardBg" or key == "HotbarBg" then return bg.cards end
    if key == "WindowBg" then return 1 end
    return nil
end

function BG.glassOne(win, inst)
    local bg = win._bg
    if not (bg and bg.glass) or not inst:IsA("GuiObject") then return end
    if bg.layer and (inst == bg.layer or inst:IsDescendantOf(bg.layer)) then return end
    -- plates are boxes that only exist over a picture, to keep text readable
    if inst:GetAttribute("OxidelibPlate") then inst.Visible = true end
    local want = BG.glassWant(win, inst)
    local base = bg.orig[inst]
    if want == nil then
        if base ~= nil then
            bg.orig[inst] = nil
            BG.setProp(win, inst, "BackgroundTransparency", base)
        end
        return
    end
    if base == nil then
        base = BG.designValue(win, inst, "BackgroundTransparency")
        if base >= 1 then return end
        bg.orig[inst] = base
    end
    BG.setProp(win, inst, "BackgroundTransparency", math.max(base, want))
end

-- The sidebar logo's outline glow is cut out by a copy of the logo in the
-- window colour. Over a picture that copy would show as a solid blob, so it
-- takes the dim layer's strength and the glow keeps running around the rim.
function BG.glassMask(win)
    local bg = win._bg
    local mask = win._sidebar and win._sidebar:FindFirstChild("WatermarkMask", true)
    if mask then BG.setProp(win, mask, "ImageTransparency", (bg and bg.glass) and (1 - bg.dim) or 0) end
end

function BG.setGlass(win, on)
    local bg = BG.state(win)
    if on then
        bg.glass = true
        for _, d in ipairs(win.Main:GetDescendants()) do BG.glassOne(win, d) end
        if not bg.addConn then
            bg.addConn = win.Main.DescendantAdded:Connect(function(d)
                task.defer(function() if d.Parent then BG.glassOne(win, d) end end)
            end)
            trackConn(win, bg.addConn)
        end
    else
        bg.glass = false
        if bg.addConn then
            bg.addConn:Disconnect(); BG.untrack(win, bg.addConn); bg.addConn = nil
        end
        for inst, base in pairs(bg.orig) do
            if inst.Parent then BG.setProp(win, inst, "BackgroundTransparency", base) end
        end
        table.clear(bg.orig)
        for _, d in ipairs(win.Main:GetDescendants()) do
            if d:GetAttribute("OxidelibPlate") then d.Visible = false end
        end
    end
    BG.glassMask(win)
end

function BG.onPaint(inst)
    for _, win in ipairs(Library._windowObjects) do
        local bg = win._bg
        if bg and bg.glass and win.Main and inst:IsDescendantOf(win.Main) then
            BG.glassOne(win, inst)
            return
        end
    end
end

function BG.clear(win)
    local bg = win._bg
    if not bg then return end
    if bg.animConn then
        bg.animConn:Disconnect(); BG.untrack(win, bg.animConn); bg.animConn = nil
    end
    if bg.layer then bg.layer:Destroy() end
    bg.layer, bg.tint, bg.labels, bg.delays, bg.ready = nil, nil, nil, nil, false
    BG.mirrorsOff(win)
    bg.ids, bg.shown, bg.accent = nil, nil, nil
    BG.paintHotbar(win)
end

function BG.step(win, dt)
    local bg = win._bg
    local labels = bg and bg.labels
    if not (labels and bg.ready) or #labels < 2 then return end
    -- a copy outside the window keeps playing while the window is hidden
    local shown = win.Main.Visible and win.ScreenGui.Enabled and win._uiVisible ~= false
    if not shown and not BG.outsideMirrorShown(bg) then return end
    local delays, n = bg.delays, #labels
    bg.clock += dt * 1000 * bg.speed
    local cur, guard = bg.index, 0
    while bg.clock >= (delays[cur] or 100) and guard < n do
        bg.clock -= (delays[cur] or 100)
        cur = cur % n + 1
        guard += 1
    end
    if guard >= n then bg.clock = 0 end
    if cur ~= bg.index then
        labels[bg.index].Visible = false
        labels[cur].Visible = true
        bg.index = cur
        local id = bg.ids and bg.ids[cur]
        for _, entry in ipairs(bg.hosts) do
            for _, img in ipairs(entry.imgs or {}) do img.Image = id end
        end
    end
end

BG.SCALES = { Crop = Enum.ScaleType.Crop, Stretch = Enum.ScaleType.Stretch, Fit = Enum.ScaleType.Fit }

-- "Crop", "Stretch" or "Fit" from whatever was passed ("fill" means Crop).
function BG.scaleMode(v)
    if type(v) == "table" then v = v[1] end
    v = string.lower(tostring(v or ""))
    if v == "fill" then return "Crop" end
    for name in pairs(BG.SCALES) do
        if string.lower(name) == v then return name end
    end
    return nil
end

-- PreloadAsync can hang on an asset that never loads, so it gets a time limit.
function BG.preload(list, seconds, wanted)
    local done = false
    task.spawn(function()
        pcall(function() game:GetService("ContentProvider"):PreloadAsync(list) end)
        done = true
    end)
    local stop = os.clock() + seconds
    while not done and os.clock() < stop and wanted() do task.wait() end
end

function BG.show(win, result)
    local bg = BG.state(win)
    BG.clear(win)
    -- ZIndex 0 under the sidebar and content (1); the window's outline glow is
    -- a stroke on Main itself, so it stays on top.
    local layer = make("Frame", { Name = "OxidelibBackground", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 0, Parent = win.Main })
    local labels = {}
    for i, id in ipairs(result.ids) do
        -- Crop fills the window and trims the edges, Stretch fills it by
        -- squashing, Fit shows the whole picture; the corner matches Main's,
        -- since ClipsDescendants does not follow rounded corners.
        local img = make("ImageLabel", {
            Name = "Frame" .. i, Image = id, ScaleType = BG.SCALES[bg.scale] or Enum.ScaleType.Crop,
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
            Visible = i == 1, ZIndex = 1, Parent = layer,
        })
        corner(img, 12)
        labels[i] = img
    end
    local tint = make("Frame", { Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.WindowBg, BackgroundTransparency = 1 - bg.dim, ZIndex = 2, Parent = layer })
    tint:SetAttribute("Theme_BackgroundColor3", "WindowBg")
    corner(tint, 12)
    bg.layer, bg.tint, bg.labels, bg.delays = layer, tint, labels, result.delays
    bg.ids, bg.shown, bg.accent = result.ids, result, BG.toColor(result.accent)
    bg.index, bg.clock, bg.ready = 1, 0, false
    if #labels > 1 then
        bg.animConn = RunService.RenderStepped:Connect(function(dt) BG.step(win, dt) end)
        trackConn(win, bg.animConn)
    end
    local function current() return bg.labels == labels end
    task.spawn(function()
        -- hidden until the first frame has loaded, so it does not pop in
        -- half-drawn; a GIF then holds that frame until every frame is
        -- loaded, or the first loop flickers
        BG.preload({ labels[1] }, 3, current)
        if not current() then return end
        layer.Visible = true
        BG.setGlass(win, true)
        BG.mirrorsOn(win)
        if #labels > 1 then BG.preload(labels, 20, current) end
        if current() then bg.ready = true end
    end)
end

-- ── Reflections ───────────────────────────────────────────────────────────
-- The tab bar under the window shows the background upside down, as if the
-- window stood on glass, and takes its colours from the picture. Other GUIs
-- can show the background too through Window:AddBackgroundMirror. Every copy
-- follows the GIF frame by frame.

-- {r, g, b} from frames.json -> Color3, or nil.
function BG.toColor(t)
    if type(t) ~= "table" or type(t[1]) ~= "number" then return nil end
    return Color3.fromRGB(t[1], t[2] or 0, t[3] or 0)
end

-- The picture's size as Roblox draws it, which flipping with ImageRect needs.
-- Nil when it is not known (an asset id) or for a still bigger than 1024,
-- where the drawn size is only a guess; those are turned round instead.
function BG.textureSize(info)
    local w, h = info and tonumber(info.width), info and tonumber(info.height)
    if not (w and h) or w < 1 or h < 1 or w > 1024 or h > 1024 then return nil end
    return w, h
end

function BG.outsideMirrorShown(bg)
    for _, entry in ipairs(bg.hosts) do
        if entry.group and entry ~= bg.hotbarEntry and entry.host.Visible then
            local gui = entry.host:FindFirstAncestorWhichIsA("LayerCollector")
            if not gui or gui.Enabled then return true end
        end
    end
    return false
end

-- Never lighter than MinDim, so text on top stays readable, and darker toward
-- the bottom, so the reflection fades out.
function BG.mirrorDim(win, entry)
    local bg = win._bg
    if not (bg and entry.fade) then return end
    local top = 1 - math.max(bg.dim, tonumber(entry.opts.MinDim) or 0.45)
    entry.fade.Transparency = NumberSequence.new(top, top * (1 - math.clamp(tonumber(entry.opts.Fade) or 0.5, 0, 1)))
end

-- The tab bar's copy sits beside the bar, not in it (a child would change the
-- bar's automatic width), so it takes the bar's place and size from it.
function BG.mirrorLayout(win, entry)
    local group, host = entry.group, entry.host
    if entry.kind ~= "reflect" or not (group and host and host.Parent) then return end
    local abs, unit = host.AbsoluteSize, host.Size.Y.Offset
    local w = (abs.Y > 0 and unit > 0) and abs.X * unit / abs.Y or abs.X
    group.AnchorPoint = host.AnchorPoint
    group.Position = host.Position
    group.Size = UDim2.fromOffset(math.floor(w + 0.5), unit)
    group.Visible = host.Visible
    -- window sized, so the bar shows the strip just above it, and grown just
    -- enough to reach the bar's ends, which stick out past the window
    local img, size = entry.img, win.Main.Size
    if img and size.X.Offset > 0 then
        local grow = math.max(1, w / size.X.Offset)
        img.Size = UDim2.fromOffset(math.ceil(size.X.Offset * grow), math.ceil(size.Y.Offset * grow))
        img.Position = UDim2.new(0.5, 0, 0, size.Y.Offset - host.Position.Y.Offset)
    end
end

function BG.makeMirror(win, entry)
    local bg = win._bg
    local host, opts = entry.host, entry.opts
    if not (bg and bg.ids and host and host.Parent) then return end
    local reflect = entry.kind == "reflect"
    local dimKey = opts.DimKey or (reflect and "HotbarBg" or "CardBg")
    if not C[dimKey] then dimKey = "CardBg" end
    local group = make("CanvasGroup", {
        Name = "OxidelibReflection", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
        ZIndex = tonumber(opts.ZIndex) or 1, Parent = reflect and host.Parent or host,
    })
    if (tonumber(opts.Corner) or 0) > 0 then corner(group, tonumber(opts.Corner)) end
    if reflect then
        -- the bar goes clear while this shows, so this is the bar's colour now
        local base = make("Frame", { Name = "Base", BackgroundColor3 = C[dimKey], Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = group })
        base:SetAttribute("Theme_BackgroundColor3", dimKey)
    end
    local img = make("ImageLabel", {
        Name = "Picture", Image = bg.ids[bg.index or 1] or bg.ids[1], BackgroundTransparency = 1,
        ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = group,
    })
    local imgs = { img }
    if reflect then
        -- lined up with the window and mirrored at its bottom edge;
        -- BG.mirrorLayout sizes it
        img.AnchorPoint = Vector2.new(0.5, 0)
        img.ScaleType = BG.SCALES[bg.scale] or Enum.ScaleType.Crop
    end
    if reflect or opts.Flip then
        local tw, th = BG.textureSize(bg.shown)
        if tw then
            img.ImageRectOffset = Vector2.new(0, th)
            img.ImageRectSize = Vector2.new(tw, -th)
        else
            img.Rotation = 180
        end
    end
    local dim = make("Frame", { Name = "Dim", BackgroundColor3 = C[dimKey], Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = group })
    dim:SetAttribute("Theme_BackgroundColor3", dimKey)
    entry.fade = make("UIGradient", { Rotation = 90, Parent = dim })
    entry.group, entry.img, entry.imgs, entry.conns = group, img, imgs, {}
    if reflect then
        for _, prop in ipairs({ "AbsoluteSize", "Position", "Visible" }) do
            table.insert(entry.conns, host:GetPropertyChangedSignal(prop):Connect(function()
                BG.mirrorLayout(win, entry)
            end))
        end
        BG.mirrorLayout(win, entry)
    end
    BG.mirrorDim(win, entry)
end

function BG.mirrorsOff(win)
    local bg = win._bg
    if not bg then return end
    for _, entry in ipairs(bg.hosts or {}) do
        for _, c in ipairs(entry.conns or {}) do c:Disconnect() end
        if entry.group then entry.group:Destroy() end
        entry.group, entry.img, entry.imgs, entry.fade, entry.conns = nil, nil, nil, nil, nil
    end
    bg.mirrored = false
end

function BG.mirrorsOn(win)
    local bg = BG.state(win)
    BG.mirrorsOff(win)
    if not bg.ids then return end
    if not bg.hotbarEntry and win._hotbar then
        bg.hotbarEntry = { host = win._hotbar, kind = "reflect", opts = { Corner = 11, ZIndex = 2 } }
        table.insert(bg.hosts, 1, bg.hotbarEntry)
    end
    for i = #bg.hosts, 1, -1 do
        local entry = bg.hosts[i]
        if entry.host and entry.host.Parent then
            BG.makeMirror(win, entry)
        elseif entry ~= bg.hotbarEntry then
            table.remove(bg.hosts, i) -- its GUI is gone
        end
    end
    bg.mirrored = true
    BG.paintHotbar(win)
    BG.syncAccent()
end

function BG.hotbarGlass(win)
    local bg = win._bg
    return bg ~= nil and bg.mirrored == true and bg.hotbarEntry ~= nil and bg.hotbarEntry.group ~= nil
end

-- A tab button's look: "active", "hover" or "idle". Over the reflection the
-- buttons go see-through and the picture's colour marks the active one.
function BG.tabLook(win, tab, state, instant)
    local glass = BG.hotbarGlass(win)
    local accent = glass and win._bg.accent or nil
    local goal
    if glass then
        goal = {
            BackgroundColor3 = accent or C.HotbarActive,
            BackgroundTransparency = (state == "active" and 0.55) or (state == "hover" and 0.8) or 1,
        }
    else
        goal = {
            BackgroundColor3 = (state == "active" and C.HotbarActive) or (state == "hover" and C.HotbarHover) or C.HotbarBg,
            BackgroundTransparency = 0,
        }
    end
    local dotColor = accent or C.Accent
    if instant then
        for k, v in pairs(goal) do tab._hBtn[k] = v end
        if tab._hDot then tab._hDot.BackgroundColor3 = dotColor end
    else
        tween(tab._hBtn, goal)
        if tab._hDot then tween(tab._hDot, { BackgroundColor3 = dotColor }) end
    end
end

-- The tab bar: clear over its reflection, border and active tab in the
-- picture's colour; back to the theme when there is no background.
function BG.paintHotbar(win)
    local hb = win._hotbar
    if not hb then return end
    local glass = BG.hotbarGlass(win)
    hb.BackgroundTransparency = glass and 1 or 0
    for _, tab in ipairs(win._tabs or {}) do
        BG.tabLook(win, tab, win._activeTab == tab and "active" or "idle")
    end
    local line = hb:FindFirstChildOfClass("UIStroke")
    local grad = line and line:FindFirstChildOfClass("UIGradient")
    if not grad then return end
    local accent = glass and win._bg.accent
    if accent then
        local mid = accent:Lerp(C.HotbarBorder, 0.55)
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, accent),
            ColorSequenceKeypoint.new(0.15, mid),
            ColorSequenceKeypoint.new(0.85, mid),
            ColorSequenceKeypoint.new(1, accent),
        })
    else
        refreshEdgeGradient(grad)
    end
end

-- ── The accent follows the picture ──────────────────────────────────────
BG.ACCENT_TWEEN = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- A colour in whole RGB steps that no other theme key uses: new parts are
-- tagged by looking their colour up, so two keys must not share one.
function BG.freeColor(color, key)
    local r, g, b = math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
    local step = b < 128 and 1 or -1
    for _ = 1, 16 do
        local c = Color3.fromRGB(r, g, b)
        local hex, taken = c:ToHex(), false
        for other, value in pairs(C) do
            if other ~= key and value:ToHex() == hex then taken = true; break end
        end
        if not taken then return c end
        b += step
    end
    return Color3.fromRGB(r, g, b)
end

-- Puts `color` into C's accent keys, or the theme's own accent for nil. The
-- darker keys keep the theme's brightness and take the picture's hue.
function BG.useAccent(color)
    local base = BG.themeAccent
    for key, value in pairs(base) do C[key] = value end
    if not color then return end
    local hue, sat = color:ToHSV()
    local _, baseSat = base.Accent:ToHSV()
    -- a grey picture gives grey accents, not red ones
    local keep = baseSat > 0.05 and math.min(1, sat / baseSat) or 1
    C.Accent = BG.freeColor(color, "Accent")
    for _, key in ipairs(BG.ACCENT_KEYS) do
        if key ~= "Accent" then
            local _, s, v = base[key]:ToHSV()
            C[key] = BG.freeColor(Color3.fromHSV(hue, s * keep, v), key)
        end
    end
end

-- The accent is the shown picture's colour (or, at start-up, the colour the
-- loading screen read from last time's picture) unless that is switched off.
function BG.syncAccent()
    local color, shown = nil, false
    for _, win in ipairs(Library._windowObjects) do
        local bg = win._bg
        if bg and bg.mirrored and win.ScreenGui and win.ScreenGui.Parent then
            shown, color = true, bg.accent
        end
    end
    if shown then BG.previewAccent = nil else color = BG.previewAccent end
    if Library.AccentFromBackground == false then color = nil end
    if color == BG.accentColor then return end
    BG.accentColor = color
    BG.useAccent(color)
    BG.repaint(BG.ACCENT_TWEEN)
end

-- The last background shown is noted, so the next loading screen can play it.
function BG.notePath()
    return string.gsub(tostring(Library.BackgroundFolder or "Oxidelib/backgrounds"), "/+$", "") .. "/last.json"
end
function BG.readNote()
    local path = BG.notePath()
    if not BG.fileExists(path) then return {} end
    local ok, note = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    return (ok and type(note) == "table") and note or {}
end
function BG.note(fields)
    if not hasFileApi() then return end
    local note = BG.readNote()
    local changed = false
    for k, v in pairs(fields) do
        if note[k] ~= v then note[k], changed = v, true end
    end
    if not changed then return end
    pcall(function()
        BG.makeFolders((string.match(BG.notePath(), "^(.*)/[^/]*$")) or "")
        writeLarge(BG.notePath(), HttpService:JSONEncode(note))
    end)
end

function BG.lastWindow()
    for index = #Library._windowObjects, 1, -1 do
        local window = Library._windowObjects[index]
        if window and window.ScreenGui and window.ScreenGui.Parent then return window end
    end
    return nil
end

-- Window:SetBackground(source, settings) -> true, info | false, reason
--   source: a file in your executor workspace or in Library.BackgroundFolder
--           ("bg.gif", "bg.png"), a folder of numbered frames, a direct link to
--           a .gif/.png/.jpg, an rbxassetid (string or number), a list of
--           frames, or nil / "" to remove the background.
--   settings (all optional, and they stick for later calls):
--     Dim              0..1  how much of the window colour sits over the picture (0.45)
--     CardTransparency 0..1  how see-through the cards get (0.25)
--     Speed            GIF speed multiplier (1)
--     Scale            "Crop" fills and trims the edges, "Stretch" fills by
--                      squashing, "Fit" shows the whole picture ("Crop")
--     MaxFrames        long GIFs are thinned to this many frames (120)
--     FPS              playback rate for frame folders and frame lists (15)
--     Refresh          true downloads a link again instead of using the saved copy
--     CacheOnly        true only uses what is already saved: nothing is
--                      downloaded or converted (the loading screen uses this)
--     OnStatus(text)   "loading", "downloading", "converting", "ready", "failed"
-- Yields while it downloads or converts, so call it from a spawned thread if
-- that matters. The first load of a GIF converts it; later loads use the cache.
-- A new call removes the old background straight away and stops its conversion.
function Window:SetBackground(source, settings)
    local bg = BG.state(self)
    settings = settings or {}
    if settings.Dim ~= nil then bg.dim = math.clamp(tonumber(settings.Dim) or bg.dim, 0, 1) end
    if settings.CardTransparency ~= nil then bg.cards = math.clamp(tonumber(settings.CardTransparency) or bg.cards, 0, 1) end
    if settings.Speed ~= nil then bg.speed = math.clamp(tonumber(settings.Speed) or bg.speed, 0, 10) end
    if settings.Scale ~= nil then bg.scale = BG.scaleMode(settings.Scale) or bg.scale end
    bg.token += 1
    local token = bg.token
    local function status(text)
        bg.status = text
        if typeof(settings.OnStatus) == "function" then task.spawn(settings.OnStatus, text) end
    end
    if source == nil or source == false or source == "" then
        BG.clear(self)
        BG.setGlass(self, false)
        bg.source, bg.info = nil, nil
        status("off")
        BG.previewAccent = nil
        BG.syncAccent()
        BG.note({ source = "" })
        return true
    end
    -- the old picture goes as soon as a new one is picked, so it never stays
    -- up while the new one downloads or converts
    BG.clear(self)
    BG.setGlass(self, false)
    bg.source, bg.info = nil, nil
    status("loading")
    local mainSize = self.Main.Size
    local tw, th = mainSize.X.Offset, mainSize.Y.Offset
    if tw < 2 or th < 2 then tw, th = self.Main.AbsoluteSize.X, self.Main.AbsoluteSize.Y end
    local target = Vector2.new(math.max(1, math.floor(tw)), math.max(1, math.floor(th)))
    local function alive() return token == bg.token and not self._destroyed end
    local ok, result, err = pcall(BG.resolve, source, settings, target, status, alive)
    if not ok then result, err = nil, tostring(result) end
    if token ~= bg.token or self._destroyed then return false, "a newer background replaced this one" end
    if not result then
        status("failed")
        BG.previewAccent = nil
        BG.syncAccent()
        return false, err
    end
    BG.show(self, result)
    bg.source, bg.info = source, result
    status("ready")
    local kind = type(source)
    BG.note({ source = (kind == "string" or kind == "number") and tostring(source) or "", scale = bg.scale, speed = bg.speed })
    return true, result
end

function Window:ClearBackground() return self:SetBackground(nil) end

function Window:SetBackgroundDim(v)
    local bg = BG.state(self)
    bg.dim = math.clamp(tonumber(v) or bg.dim, 0, 1)
    if bg.tint then bg.tint.BackgroundTransparency = 1 - bg.dim end
    for _, entry in ipairs(bg.hosts) do BG.mirrorDim(self, entry) end
    BG.glassMask(self)
    return bg.dim
end

function Window:SetBackgroundCardTransparency(v)
    local bg = BG.state(self)
    bg.cards = math.clamp(tonumber(v) or bg.cards, 0, 1)
    if bg.glass then
        for inst in pairs(bg.orig) do BG.glassOne(self, inst) end
    end
    return bg.cards
end

function Window:SetBackgroundSpeed(v)
    local bg = BG.state(self)
    bg.speed = math.clamp(tonumber(v) or bg.speed, 0, 10)
    return bg.speed
end

function Window:SetBackgroundScale(v)
    local bg = BG.state(self)
    bg.scale = BG.scaleMode(v) or bg.scale
    for _, img in ipairs(bg.labels or {}) do img.ScaleType = BG.SCALES[bg.scale] end
    for _, img in ipairs(bg.hotbarEntry and bg.hotbarEntry.imgs or {}) do
        img.ScaleType = BG.SCALES[bg.scale]
    end
    if bg.source then BG.note({ scale = bg.scale }) end
    return bg.scale
end

-- status is "off", "loading", "downloading", "converting", "ready" or "failed";
-- info has kind, frame count and the picture's size once it is ready.
function Window:GetBackgroundStatus()
    local bg = BG.state(self)
    local info = bg.info and {
        kind = bg.info.kind, frames = #bg.info.ids,
        width = bg.info.width, height = bg.info.height,
        sourceWidth = bg.info.sourceWidth, sourceHeight = bg.info.sourceHeight,
    } or nil
    return bg.status, info
end

-- The current picture's main colour as a Color3, or nil when there is no
-- background or it has no clear colour. Only GIFs are read: Luau cannot
-- decode a PNG or JPG here, so those give nil.
function Window:GetBackgroundAccent()
    local bg = self._bg
    return bg and bg.mirrored and bg.accent or nil
end

-- Window:AddBackgroundMirror(host, opts) -> remove()
--   Shows the background inside `host`, a GuiObject in any ScreenGui, kept on
--   the GIF's current frame and following background changes until removed.
--   One per host: adding the same host again replaces it.
--   opts: Corner (0), ZIndex (1), Flip (false) shows it upside down,
--         DimKey theme colour laid over it ("CardBg"), MinDim (0.45) least
--         dim, Fade 0..1 how much darker it gets toward the bottom (0.5)
function Window:AddBackgroundMirror(host, opts)
    if typeof(host) ~= "Instance" or not host:IsA("GuiObject") then return nil end
    local bg = BG.state(self)
    for i = #bg.hosts, 1, -1 do
        local entry = bg.hosts[i]
        if entry ~= bg.hotbarEntry and (entry.host == host or not (entry.host and entry.host.Parent)) then
            for _, c in ipairs(entry.conns or {}) do c:Disconnect() end
            if entry.group then entry.group:Destroy() end
            table.remove(bg.hosts, i)
        end
    end
    local entry = { host = host, kind = "fill", opts = type(opts) == "table" and opts or {} }
    table.insert(bg.hosts, entry)
    if bg.mirrored then BG.makeMirror(self, entry) end
    return function()
        local i = table.find(bg.hosts, entry)
        if i then table.remove(bg.hosts, i) end
        if entry.group then entry.group:Destroy() end
        entry.group, entry.img, entry.imgs, entry.fade = nil, nil, nil, nil
    end
end

function Library:SetBackground(source, settings)
    for index = #Library._windowObjects, 1, -1 do
        local window = Library._windowObjects[index]
        if window and window.ScreenGui and window.ScreenGui.Parent then
            return window:SetBackground(source, settings)
        end
    end
    return false, "create a window before calling Library:SetBackground"
end

-- true while a background picture is showing
function Window:HasBackground()
    local bg = self._bg
    return bg ~= nil and bg.mirrored == true
end

function Library:HasBackground()
    local window = BG.lastWindow()
    return window ~= nil and window:HasBackground()
end

function Library:GetBackgroundAccent()
    local window = BG.lastWindow()
    return window and window:GetBackgroundAccent() or nil
end

function Library:AddBackgroundMirror(host, opts)
    local window = BG.lastWindow()
    return window and window:AddBackgroundMirror(host, opts) or nil
end

