            local num = make("Frame", { Position = UDim2.fromOffset(7, 6), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = active and C.Accent or C.CardBg, ZIndex = 154, Parent = row })
            corner(num, 8)
            make("TextLabel", { Text = tostring(i), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = active and C.AccentText or C.TextGray, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 155, Parent = num })
            make("TextLabel", { Text = t.name, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = active and C.White or C.TextGray, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -76, 1, 0), ZIndex = 154, Parent = row })
            local rm = make("TextButton", { Text = "", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, ZIndex = 155, Parent = row })
            local x1 = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(11, 2), BackgroundColor3 = C.TextDim, Rotation = 45, ZIndex = 156, Parent = rm })
            corner(x1, 1)
            local x2 = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(11, 2), BackgroundColor3 = C.TextDim, Rotation = -45, ZIndex = 156, Parent = rm })
            corner(x2, 1)
            row.MouseEnter:Connect(function() if not (currentIndex == i) then tween(row, { BackgroundColor3 = C.ElementHover }) end end)
            row.MouseLeave:Connect(function() if not (currentIndex == i) then tween(row, { BackgroundColor3 = C.Element }) end end)
            rm.MouseEnter:Connect(function() tween(x1, { BackgroundColor3 = C.White }); tween(x2, { BackgroundColor3 = C.White }) end)
            rm.MouseLeave:Connect(function() tween(x1, { BackgroundColor3 = C.TextDim }); tween(x2, { BackgroundColor3 = C.TextDim }) end)
            row.MouseButton1Click:Connect(function() playIndex(i) end)
            rm.MouseButton1Click:Connect(function()
                table.remove(tracks, i)
                if currentIndex == i then
                    pcall(function() musicSound:Stop() end); isPlaying = false; currentIndex = 0
                elseif currentIndex > i then currentIndex = currentIndex - 1 end
                updateNowPlaying(); refreshPlaylist()
            end)
            rows[i] = row
        end
    end

    function playIndex(i)
        if #tracks == 0 then return end
        if i < 1 then i = #tracks elseif i > #tracks then i = 1 end
        local t = tracks[i]
        if not t.id then
            if assetLoader then
                local ok, res = pcall(assetLoader, t.path)
                if ok and res then t.id = res end
            end
        end
        if not t.id then
            currentIndex = i; npTitle.Text = t.name
            npSub.Text = assetLoader and "Couldn't load file" or "Asset loader unavailable"
            isPlaying = false; updateNowPlaying(); refreshPlaylist(); return
        end
        currentIndex = i
        musicSound.SoundId = t.id
        musicSound.TimePosition = 0
        pcall(function() musicSound:Play() end)
        isPlaying = true
        updateNowPlaying(); refreshPlaylist()
    end

    local function togglePlay()
        if #tracks == 0 then return end
        if currentIndex == 0 then playIndex(1); return end
        if isPlaying then pcall(function() musicSound:Pause() end); isPlaying = false
        else pcall(function() musicSound:Resume() end); isPlaying = true end
        updateNowPlaying(); refreshPlaylist()
    end
    local function nextTrack()
        if #tracks == 0 then return end
        playIndex(currentIndex + 1)
    end
    local function prevTrack()
        if #tracks == 0 then return end
        if musicSound.TimePosition > 3 then musicSound.TimePosition = 0 else playIndex(currentIndex - 1) end
    end
    local function rescan()
        if not (fsList and fsIsFolder) then npSub.Text = "File API unavailable"; updateNowPlaying(); refreshPlaylist(); return end
        if fsMakeFolder and not fsIsFolder(MUSIC_FOLDER) then pcall(fsMakeFolder, MUSIC_FOLDER) end
        local prev = tracks[currentIndex]
        tracks = {}; currentIndex = 0
        if fsIsFolder(MUSIC_FOLDER) then
            local ok, files = pcall(fsList, MUSIC_FOLDER)
            if ok and files then
                for _, f in ipairs(files) do
                    local lf = string.lower(f)
                    if lf:sub(-4) == ".mp3" or lf:sub(-4) == ".ogg" or lf:sub(-4) == ".wav" or lf:sub(-5) == ".flac" then
                        table.insert(tracks, { name = baseName(f), path = f })
                        if prev and prev.path == f then currentIndex = #tracks end
                    end
                end
            end
        end
        updateNowPlaying(); refreshPlaylist()
    end

    -- Sliders
    local function setVol(f)
        f = math.clamp(f, 0, 1); musicSound.Volume = f
        volFill.Size = UDim2.new(f, 0, 1, 0); volKnob.Position = UDim2.new(f, 0, 0.5, 0)
    end
    setVol(0.5)
    local volDrag, seekDrag = false, false
    volBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then volDrag = true; setVol((i.Position.X - volBg.AbsolutePosition.X) / math.max(1, volBg.AbsoluteSize.X)) end end)
    volBg.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then volDrag = false end end)
    progBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then seekDrag = true end end)
    progBg.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if seekDrag and musicSound.TimeLength > 0 then
                musicSound.TimePosition = math.clamp((i.Position.X - progBg.AbsolutePosition.X) / math.max(1, progBg.AbsoluteSize.X), 0, 1) * musicSound.TimeLength
            end
            seekDrag = false
        end
    end)
    table.insert(musicConns, UserInputService.InputChanged:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
        if volDrag then setVol((i.Position.X - volBg.AbsolutePosition.X) / math.max(1, volBg.AbsoluteSize.X)) end
        if seekDrag then
            local f = math.clamp((i.Position.X - progBg.AbsolutePosition.X) / math.max(1, progBg.AbsoluteSize.X), 0, 1)
            progFill.Size = UDim2.new(f, 0, 1, 0); progKnob.Position = UDim2.new(f, 0, 0.5, 0)
        end
    end))

    -- Wire
    playBtn.MouseButton1Click:Connect(togglePlay)
    nextBtn.MouseButton1Click:Connect(nextTrack)
    prevBtn.MouseButton1Click:Connect(prevTrack)
    refreshBtn.MouseButton1Click:Connect(rescan)
    refreshBtn.MouseEnter:Connect(function() tween(refreshBtn, { BackgroundColor3 = C.ElementHover }); tween(refreshIcon, { ImageColor3 = C.White }) end)
    refreshBtn.MouseLeave:Connect(function() tween(refreshBtn, { BackgroundColor3 = C.Element }); tween(refreshIcon, { ImageColor3 = C.TextGray }) end)
    table.insert(musicConns, musicSound.Ended:Connect(function() nextTrack() end))
    table.insert(musicConns, RunService.RenderStepped:Connect(function()
        if not (musicPanel and musicPanel.Parent) or not musicOpen then return end
        local len = musicSound.TimeLength
        if isPlaying and len and len > 0 then
            if not seekDrag then
                local f = math.clamp(musicSound.TimePosition / len, 0, 1)
                progFill.Size = UDim2.new(f, 0, 1, 0); progKnob.Position = UDim2.new(f, 0, 0.5, 0)
            end
            curTime.Text = fmtTime(musicSound.TimePosition); totTime.Text = fmtTime(len)
        end
    end))
    table.insert(musicConns, { Disconnect = function() pcall(function() musicSound:Stop(); musicSound:Destroy() end) end })

    -- Minimize / close
    local function setMinimized(m)
        minimized = (m == true)
        for _, e in ipairs(lowerEls) do e.Visible = not minimized end
        TweenService:Create(musicPanel, PROFILE_TWEEN, { Size = UDim2.fromOffset(musicWidth, minimized and compactHeight or fullHeight) }):Play()
    end
    minimizeBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end)

    local function setMusicVisible(v, instant)
        musicOpen = (v == true)
        local tp = musicOpen and musicOpenPos or musicClosedPos
        local tr = musicOpen and 0 or 1
        if instant then
            musicPanel.Position = tp; musicPanel.GroupTransparency = tr
        else
            TweenService:Create(musicPanel, PROFILE_TWEEN, { Position = tp, GroupTransparency = tr }):Play()
        end
        if musicToggleBtn then musicToggleBtn.BackgroundColor3 = musicOpen and C.PillActive or C.Element end
        if musicToggleIcon then musicToggleIcon.ImageColor3 = musicOpen and C.Accent or C.TextGray end
        if musicOpen and #tracks == 0 then rescan() end
    end
    local function toggleMusic() setMusicVisible(not musicOpen) end
    local function closeMusic(instant) setMusicVisible(false, instant) end
    musicCloseBtn.MouseButton1Click:Connect(function() setMusicVisible(false) end)

    if musicToggleBtn then
        musicToggleBtn.MouseEnter:Connect(function() if not musicOpen then tween(musicToggleBtn, { BackgroundColor3 = C.ElementHover }) end end)
        musicToggleBtn.MouseLeave:Connect(function() tween(musicToggleBtn, { BackgroundColor3 = musicOpen and C.PillActive or C.Element }) end)
    end

    rescan(); updateNowPlaying()
    return toggleMusic, closeMusic
end

-- ════════════════════════════════════════════════════════════════════════════
-- LOADING SCREEN
-- The background shown last time plays in a glowing card while the name slams
-- in under it, all in the picture's colour. With no saved picture (a first
-- run, or opts.LoadingBackground = false) it is the same screen without the
-- card, in the theme's accent.
-- ════════════════════════════════════════════════════════════════════════════
local function buildLoadingScreen(screenGui, opts, windowSize)
    local duration = math.clamp(tonumber(opts.LoadingDuration) or 2.65, 1.5, 8)
    local overlay  = math.clamp(tonumber(opts.LoadingOverlayTransparency) or 0.35, 0, 0.9)
    local white, black = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
    local started = os.clock()
    local L = { motionDone = false, deadline = started + duration + 4 }

    -- the picture comes from the saved copy only: nothing is downloaded or
    -- converted here, so it is quick, and a first run just has no card
    local shot -- nil while looking, false when there is none
    if opts.LoadingBackground == false then
        shot = false
    else
        task.spawn(function()
            local note = BG.readNote()
            local source = type(note.source) == "string" and note.source or ""
            local target = Vector2.new(math.max(1, windowSize.X.Offset), math.max(1, windowSize.Y.Offset))
            local ok, result = false, nil
            if source ~= "" then
                ok, result = pcall(BG.resolve, source, { CacheOnly = true }, target, function() end, function() return not L.gone end)
            end
            if not (ok and type(result) == "table" and type(result.ids) == "table" and #result.ids > 0) then
                shot = false
                return
            end
            result.scale = BG.scaleMode(note.scale) or "Crop"
            result.speed = math.clamp(tonumber(note.speed) or 1, 0, 10)
            shot = result
            -- the menu takes the picture's colour now, so it does not show the
            -- theme's colour until its own copy of the picture has loaded
            local accent = BG.toColor(result.accent)
            if accent and note.match ~= false then
                BG.previewAccent = accent
                BG.syncAccent()
            end
        end)
    end

    -- the loader keeps its own colours: nothing in it is repainted by themes
    local function untag(inst)
        for name in pairs(inst:GetAttributes()) do
            if string.sub(name, 1, 6) == "Theme_" then inst:SetAttribute(name, nil) end
        end
    end

    local layer = make("CanvasGroup", {
        Name = "StartupLoader", Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = black, BackgroundTransparency = 1,
        GroupTransparency = 0, ZIndex = 500, Parent = screenGui,
    })
    L.layer = layer

    if opts.LoadingBlur ~= false then
        L.blur = Instance.new("BlurEffect")
        L.blur.Size = 0
        pcall(function() L.blur.Parent = game:GetService("Lighting") end)
    end
    if opts.LoadingSound then
        local sound = Instance.new("Sound")
        sound.SoundId = normalizeAssetId(opts.LoadingSound)
        sound.Volume = 0
        sound.Looped = false
        sound.TimePosition = tonumber(opts.LoadingSoundStart) or 0
        pcall(function() sound.Parent = game:GetService("SoundService") end)
        L.sound = sound
    end

    -- the colour glows up from the bottom of the screen
    local wash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, BackgroundTransparency = 1, ZIndex = 501, Parent = layer })
    make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.94), NumberSequenceKeypoint.new(1, 0.72),
    }), Parent = wash })

    -- 620 x 470 of content, scaled down to fit small screens
    local content = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(620, 470), BackgroundTransparency = 1, ZIndex = 502, Parent = layer,
    })
    local fit = make("UIScale", { Parent = content })
    do
        local cam = Workspace.CurrentCamera
        local view = cam and cam.ViewportSize or Vector2.new(1280, 720)
        fit.Scale = math.clamp(math.min(view.X * 0.92 / 620, view.Y * 0.86 / 470), 0.35, 1)
    end
    local stage = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 502, Parent = content,
    })
    local motion = make("UIScale", { Parent = stage })

    -- the card: the picture, shaded toward the bottom, with a light that runs
    -- round its edge and soft rings of glow outside it
    local cardW = 400
    local cardH = math.floor(cardW * math.clamp(windowSize.Y.Offset / math.max(1, windowSize.X.Offset), 0.4, 1) + 0.5)
    local cardWrap = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(310, 18 + cardH / 2),
        Size = UDim2.fromOffset(cardW, cardH), BackgroundTransparency = 1, Visible = false, ZIndex = 503, Parent = stage,
    })
    local cardScale = make("UIScale", { Scale = 0.82, Parent = cardWrap })
    local rings = {}
    for i, ring in ipairs({ { 2, 0.1 }, { 5, 0.62 }, { 10, 0.8 }, { 17, 0.89 }, { 26, 0.95 } }) do
        local holder = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 503, Parent = cardWrap })
        corner(holder, 14)
        rings[i] = {
            stroke = make("UIStroke", { Thickness = ring[1], Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = holder }),
            strength = 1 - ring[2],
        }
    end
    local card = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = black, GroupTransparency = 1, ZIndex = 504, Parent = cardWrap })
    corner(card, 14)
    local shade = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = black, ZIndex = 3, Parent = card })
    make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.55, 0.9), NumberSequenceKeypoint.new(1, 0.4),
    }), Parent = shade })
    local sheen = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, ZIndex = 4, Parent = card })
    local sheenGrad = make("UIGradient", { Rotation = 25, Offset = Vector2.new(-1, 0), Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 1), NumberSequenceKeypoint.new(0.5, 0.55),
        NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(1, 1),
    }), Parent = sheen })
    local edgeHolder = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 505, Parent = cardWrap })
    corner(edgeHolder, 14)
    local edge = make("UIStroke", { Color = white, Thickness = 1.5, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = edgeHolder })
    local edgeGrad = make("UIGradient", { Parent = edge })

    -- the name, the subtitle in spaced capitals, a bar and the footer
    local function label(props)
        props.AnchorPoint = Vector2.new(0.5, 0.5)
        props.BackgroundTransparency = 1
        props.TextTransparency = 1
        props.TextXAlignment = Enum.TextXAlignment.Center
        props.ZIndex = 506
        props.Parent = stage
        return make("TextLabel", props)
    end
    local title = label({
        Position = UDim2.fromOffset(310, 340), Size = UDim2.fromOffset(600, 50),
        Text = tostring(opts.LoadingText or opts.Name or "Oxidelib"), Font = Enum.Font.GothamBlack, TextScaled = true,
        TextColor3 = white, TextStrokeColor3 = black, TextStrokeTransparency = 1,
    })
    make("UITextSizeConstraint", { MaxTextSize = 44, Parent = title })
    local titleScale = make("UIScale", { Scale = 1.7, Parent = title })
    local titleGrad = make("UIGradient", { Parent = title })
    local subText = tostring(opts.LoadingSubtitle or "HUB")
    pcall(function()
        local letters = {}
        for _, code in utf8.codes(string.upper(subText)) do table.insert(letters, utf8.char(code)) end
        subText = table.concat(letters, " ")
    end)
    local sub = label({
        Position = UDim2.fromOffset(310, 381), Size = UDim2.fromOffset(600, 18),
        Text = subText, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = white,
    })
    local track = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(310, 410), Size = UDim2.fromOffset(240, 4),
        BackgroundColor3 = white, BackgroundTransparency = 1, ZIndex = 506, Parent = stage,
    })
    circle(track)
    local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = white, ZIndex = 507, Parent = track })
    circle(fill)
    local fillGrad = make("UIGradient", { Parent = fill })
    local head = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(8, 8),
        BackgroundColor3 = white, BackgroundTransparency = 1, ZIndex = 508, Parent = fill,
    })
    circle(head)
    local headGlow = make("UIStroke", { Color = white, Thickness = 4, Transparency = 1, Parent = head })
    local footer = label({
        Position = UDim2.fromOffset(310, 434), Size = UDim2.fromOffset(600, 14),
        Text = tostring(opts.LoadingFooter or "Oxidelib"), Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = white,
    })
    untag(layer)
    for _, d in ipairs(layer:GetDescendants()) do untag(d) end

    local function tint(acc)
        local light = acc:Lerp(white, 0.3)
        local deep = acc:Lerp(black, 0.5)
        wash.BackgroundColor3 = acc
        rings[1].stroke.Color = acc:Lerp(white, 0.35)
        for i = 2, #rings do rings[i].stroke.Color = acc end
        edgeGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, acc), ColorSequenceKeypoint.new(0.44, acc),
            ColorSequenceKeypoint.new(0.5, white),
            ColorSequenceKeypoint.new(0.56, acc), ColorSequenceKeypoint.new(1, acc),
        })
        titleGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, light), ColorSequenceKeypoint.new(0.42, light),
            ColorSequenceKeypoint.new(0.5, white),
            ColorSequenceKeypoint.new(0.58, light), ColorSequenceKeypoint.new(1, light),
        })
        title.TextStrokeColor3 = deep
        sub.TextColor3 = acc:Lerp(white, 0.65)
        footer.TextColor3 = acc:Lerp(white, 0.5)
        fillGrad.Color = ColorSequence.new(deep:Lerp(acc, 0.4), light)
        headGlow.Color = acc
    end

    local labels, delays, speed, playing, glowOn = {}, nil, 1, false, false
    local t, glow, frame, clock = 0, 0, 1, 0
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not layer.Parent then conn:Disconnect(); return end
        t += dt
        titleGrad.Offset = Vector2.new((t * 0.7) % 3 - 1, 0)
        edgeGrad.Rotation = (t * 110) % 360
        glow += ((glowOn and 1 or 0) - glow) * math.min(1, dt * 5)
        local breathe = 0.82 + 0.18 * math.sin(t * 2.6)
        for i, ring in ipairs(rings) do
            ring.stroke.Transparency = 1 - ring.strength * glow * (i == 1 and 1 or breathe)
        end
        edge.Transparency = 1 - glow
        -- the GIF plays on its own delays once every frame has loaded
        local n = #labels
        if playing and n > 1 then
            clock += dt * 1000 * speed
            local cur, guard = frame, 0
            while clock >= (delays[cur] or 100) and guard < n do
                clock -= (delays[cur] or 100)
                cur = cur % n + 1
                guard += 1
            end
            if guard >= n then clock = 0 end
            if cur ~= frame then
                labels[frame].Visible = false
                labels[cur].Visible = true
                frame = cur
            end
        end
    end)

    local function run()
        if L.blur then TweenService:Create(L.blur, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = 12 }):Play() end
        if L.sound then
            pcall(function() L.sound:Play() end)
            TweenService:Create(L.sound, TweenInfo.new(0.5), { Volume = math.clamp(tonumber(opts.LoadingSoundVolume) or 0.45, 0, 1) }):Play()
        end
        TweenService:Create(layer, TweenInfo.new(0.34, Enum.EasingStyle.Quad), { BackgroundTransparency = overlay }):Play()
        -- a saved picture is there in a moment; past that it goes on without
        local stop = os.clock() + 0.9
        while shot == nil and os.clock() < stop do task.wait() end
        if not layer.Parent then return end
        local pic = shot or nil
        tint((pic and BG.toColor(pic.accent)) or C.Accent)
        TweenService:Create(wash, TweenInfo.new(0.8, Enum.EasingStyle.Quad), { BackgroundTransparency = 0 }):Play()
        if pic then
            delays, speed = pic.delays or {}, pic.speed or 1
            for i, id in ipairs(pic.ids) do
                local img = make("ImageLabel", {
                    Image = id, ScaleType = BG.SCALES[pic.scale] or Enum.ScaleType.Crop,
                    BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = i == 1, ZIndex = 1, Parent = card,
                })
                untag(img)
                labels[i] = img
            end
            local function alive() return layer.Parent ~= nil end
            -- held back until the first frame has loaded, so it does not pop in
            -- half drawn; a GIF holds that frame until every frame is loaded
            BG.preload({ labels[1] }, 1.5, alive)
            if not layer.Parent then return end
            if #labels > 1 then
                task.spawn(function()
                    BG.preload(labels, 10, alive)
                    playing = true
                end)
            end
            cardWrap.Visible = true
            glowOn = true
            TweenService:Create(cardScale, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
            TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { GroupTransparency = 0 }):Play()
            task.delay(0.2, function()
                if sheen.Parent then
                    TweenService:Create(sheenGrad, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Offset = Vector2.new(1, 0) }):Play()
                end
            end)
            task.wait(0.35)
        else
            for _, item in ipairs({ title, sub, track, footer }) do
                item.Position = item.Position + UDim2.fromOffset(0, -150)
            end
        end
        if not layer.Parent then return end
        -- the name slams in, and everything jolts as it lands
        TweenService:Create(title, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { TextTransparency = 0, TextStrokeTransparency = 0.55 }):Play()
        TweenService:Create(titleScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
        task.delay(0.15, function()
            if not layer.Parent then return end
            local hit = TweenService:Create(motion, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.025 })
            hit:Play()
            hit.Completed:Wait()
            if L.finishing then return end
            TweenService:Create(motion, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
        end)
        task.wait(0.22)
        TweenService:Create(sub, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { TextTransparency = 0.1 }):Play()
        TweenService:Create(track, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { BackgroundTransparency = 0.88 }):Play()
        TweenService:Create(head, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { BackgroundTransparency = 0 }):Play()
        TweenService:Create(headGlow, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Transparency = 0.55 }):Play()
        task.wait(0.12)
        TweenService:Create(footer, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { TextTransparency = 0.35 }):Play()
        -- the bar fills over the rest of the time
        local rest = math.max(0.5, duration - (os.clock() - started))
        TweenService:Create(fill, TweenInfo.new(rest, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Size = UDim2.fromScale(1, 1) }):Play()
        task.wait(rest)
    end
    task.spawn(function()
        local ok, err = pcall(run)
        if not ok then warn("[Oxidelib] loading screen: " .. tostring(err)) end
        L.motionDone = true
    end)

    -- fades the loader away as the card flies toward you, then removes it
    function L.finish()
        L.finishing = true
        local info = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        local fade = TweenService:Create(layer, info, { GroupTransparency = 1 })
        fade:Play()
        TweenService:Create(motion, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Scale = 1.12 }):Play()
        if L.blur then TweenService:Create(L.blur, info, { Size = 0 }):Play() end
        if L.sound then TweenService:Create(L.sound, TweenInfo.new(0.5), { Volume = 0 }):Play() end
        fade.Completed:Wait()
        L.gone = true
        conn:Disconnect()
        if layer.Parent then layer:Destroy() end
        pcall(function() if L.blur then L.blur:Destroy() end end)
        pcall(function() if L.sound then L.sound:Stop(); L.sound:Destroy() end end)
        -- if the menu never shows a background of its own, the picture's
        -- colour does not stay on it
        task.delay(8, function()
            if BG.previewAccent then
                BG.previewAccent = nil
                BG.syncAccent()
            end
        end)
    end
    return L
end

