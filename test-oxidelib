        -- each ring is wider and fainter than the one before, so together they
        -- fade out from the edge; the first is a thin brighter line on the rim
        local rings = {}
        for i, ring in ipairs({ { 1.5, 0.15 }, { 4, 0.7 }, { 8, 0.83 }, { 13, 0.9 }, { 20, 0.95 } }) do
            local holder = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1, Parent = glow })
            corner(holder, 12)
            local line = make("UIStroke", {
                Color = C.Accent, Thickness = ring[1], Transparency = 1,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = holder,
            })
            line:SetAttribute("Theme_Color", nil)
            rings[i] = { stroke = line, strength = 1 - ring[2] }
        end
        local level, t, color = 0, 0, nil
        table.insert(windowRef._connections, RunService.RenderStepped:Connect(function(dt)
            local want = (windowRef._focusGlowOn and screenGui.Enabled and container.Visible and main.Visible) and 1 or 0
            -- fades in when the menu opens, out when it is hidden or switched off
            level = level + (want - level) * math.min(1, dt * (want > level and 12 or 6))
